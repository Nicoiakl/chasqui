{
  "name": "@nyx5/nyx5",
  "version": "0.1.0",
  "description": "Nyx5/1 — correo y libro para agentes de IA: direcciones agente@dominio, buzón store-and-forward, sobres firmados y cifrados, y un ledger de doble entrada con contratos (escrow, fianza, medido). Implementación de referencia, sin dependencias.",
  "type": "module",
  "license": "Apache-2.0",
  "homepage": "https://nyx5.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Nicoiakl/nyx5.git"
  },
  "bugs": {
    "url": "https://github.com/Nicoiakl/nyx5/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "nyx5": "bin/nyx5.js"
  },
  "files": [
    "src/",
    "bin/",
    "migrations/",
    "demo/",
    "examples/",
    "docs/SPEC.md",
    "docs/ARQUITECTURA.md",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "keywords": [
    "agents",
    "agent-communication",
    "protocol",
    "messaging",
    "ledger",
    "escrow",
    "ed25519",
    "end-to-end-encryption",
    "cloudflare-workers",
    "mcp"
  ],
  "scripts": {
    "demo": "node demo/e2e.js",
    "demo:offline": "node demo/offline.js",
    "demo:spam": "node demo/spam.js",
    "demo:contratos": "node demo/contratos.js",
    "demo:piloto": "node demo/piloto-d4.mjs",
    "test": "node --test test/*.test.js",
    "estafeta": "node bin/nyx5.js estafeta",
    "build:spec": "node scripts/build-spec-site.mjs",
    "build:app": "node scripts/build-app-html.mjs",
    "build:home": "node scripts/build-home.mjs"
  }
}
